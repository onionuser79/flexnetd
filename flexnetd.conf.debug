# flexnetd.conf.debug — debugging template for flexnetd v1.0
#
#   make debug
#   sudo ./flexnetd_debug -f -vvv -l /tmp/flexnetd_debug.log -c flexnetd.conf.debug
#
# Debug logging (hex dump of every CE/CF frame), no syslog, and a 10 s
# path-query interval. Set the identity and Port lines to match your
# production flexnetd.conf.

MyCall          NODEA-3
Alias           NODEA
MinSSID         3
MaxSSID         3
Role            server

Port xnet  NODEB-14  NODEA-3  route_advert=0  lt_reply=0    advert_mode=full
# Port pcf   NODEC-12  NODEA-3  route_advert=0  lt_reply=320  advert_mode=record

PollInterval          240
PathProbeInterval      10
RouteAdvertInterval     0
LinkTimeReplyInterval 320

GatewaysFile    /usr/local/var/lib/ax25/flex/gateways
DestFile        /usr/local/var/lib/ax25/flex/destinations
LinkStatsFile   /usr/local/var/lib/ax25/flex/linkstats
PathsFile       /usr/local/var/lib/ax25/flex/paths

Infinity        60000

LogLevel        4
Syslog          no
